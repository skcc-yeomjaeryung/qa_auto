{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-auto.local/schemas/component_contract.schema.json",
  "title": "ComponentContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "serviceId",
    "screenA",
    "screenB",
    "inputs",
    "outputs",
    "warnings",
    "screenshotHooks",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "component-contract/v1" },
    "contractId": { "type": "string", "minLength": 1 },
    "scenarioId": { "type": ["string", "null"] },
    "serviceId": { "type": "string", "minLength": 1 },
    "projectId": { "type": ["string", "null"] },
    "sourceRefs": {
      "type": "object",
      "additionalProperties": true
    },
    "screenA": {
      "type": "object",
      "required": ["route"],
      "properties": {
        "name": { "type": "string" },
        "route": { "type": "string" }
      },
      "additionalProperties": true
    },
    "screenB": {
      "type": "object",
      "required": ["routePattern"],
      "properties": {
        "name": { "type": "string" },
        "routePattern": { "type": "string" }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/inputContract" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/outputContract" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionContract" }
    },
    "validationMismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "message"],
        "properties": {
          "kind": { "type": "string" },
          "field": { "type": ["string", "null"] },
          "message": { "type": "string" },
          "confirmed": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "screenshotHooks": {
      "type": "object",
      "required": ["points", "maskRegions"],
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "when"],
            "properties": {
              "id": { "type": "string" },
              "when": { "type": "string" },
              "screen": { "type": "string" },
              "filledAtRuntime": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "maskRegions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "reason"],
            "properties": {
              "id": { "type": "string" },
              "locator": { "$ref": "#/$defs/locator" },
              "reason": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "adapterRef": { "type": ["string", "null"] },
    "missing_data": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "generatedAt": { "type": "string" }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "required": ["strategy", "value"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["testId", "role", "label", "id", "name", "css", "xpath"]
        },
        "value": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "stable": { "type": "boolean" },
        "priority": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "inputContract": {
      "type": "object",
      "required": ["field", "required", "type", "locator", "events"],
      "properties": {
        "field": { "type": "string" },
        "logicalName": { "type": "string" },
        "semanticType": { "type": ["string", "null"] },
        "componentType": { "type": "string" },
        "required": { "type": "boolean" },
        "type": { "type": "string" },
        "format": { "type": ["string", "null"] },
        "pattern": { "type": ["string", "null"] },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "enum": { "type": ["array", "null"], "items": { "type": "string" } },
        "defaultValue": {},
        "locator": { "$ref": "#/$defs/locator" },
        "events": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommendationReady": { "type": "boolean" },
        "sources": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "reviewRequired": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "outputContract": {
      "type": "object",
      "required": ["field", "responsePath", "uiLocator"],
      "properties": {
        "field": { "type": "string" },
        "responsePath": { "type": "string" },
        "uiLocator": { "$ref": "#/$defs/locator" },
        "normalize": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assertion": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "reviewRequired": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "actionContract": {
      "type": "object",
      "required": ["id", "kind", "events", "locator"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "logicalName": { "type": "string" },
        "events": { "type": "array", "items": { "type": "string" } },
        "locator": { "$ref": "#/$defs/locator" },
        "sources": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      },
      "additionalProperties": true
    }
  }
}
