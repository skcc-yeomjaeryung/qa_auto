{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-auto.local/schemas/backend_telemetry.schema.json",
  "title": "BackendTelemetryEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "event", "testRunId"],
  "properties": {
    "timestamp": { "type": "string" },
    "event": {
      "type": "string",
      "enum": [
        "request_received",
        "validation_passed",
        "validation_failed",
        "controller_entered",
        "service_called",
        "response_returned",
        "exception_mapped"
      ]
    },
    "testRunId": { "type": "string" },
    "scenarioId": { "type": ["string", "null"] },
    "scenarioVersion": { "type": ["string", "null"] },
    "testCaseId": { "type": ["string", "null"] },
    "inputProfileId": { "type": ["string", "null"] },
    "requestSequence": { "type": "integer", "minimum": 1 },
    "controller": { "type": ["string", "null"] },
    "service": { "type": ["string", "null"] },
    "httpMethod": { "type": ["string", "null"] },
    "path": { "type": ["string", "null"] },
    "request": { "type": ["object", "null"], "additionalProperties": true },
    "response": { "type": ["object", "null"], "additionalProperties": true },
    "status": { "type": ["integer", "null"] },
    "durationMs": { "type": ["integer", "null"] },
    "maskedFields": { "type": "array", "items": { "type": "string" } },
    "truncated": { "type": "boolean" },
    "truncationMeta": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "source": {
      "type": "string",
      "enum": ["spring", "http_ingest", "file", "otel", "browser_network"]
    },
    "constraint": { "type": ["string", "null"] },
    "errorType": { "type": ["string", "null"] },
    "errorMessage": { "type": ["string", "null"] }
  }
}
