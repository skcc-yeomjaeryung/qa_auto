{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/evidence_manifest.schema.json",
  "title": "EvidenceManifest",
  "type": "object",
  "required": [
    "evidenceId",
    "runId",
    "scenario",
    "commitRefs",
    "inputProfile",
    "technicalStatus",
    "reviewStatus",
    "artifacts",
    "createdAt"
  ],
  "properties": {
    "evidenceId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "commitRefs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "inputProfile": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "technicalStatus": {
      "enum": [
        "AUTO_PASSED",
        "AUTO_FAILED",
        "CANCELLED",
        "PARTIAL"
      ]
    },
    "reviewStatus": {
      "enum": [
        "WAITING_FOR_REVIEW",
        "APPROVED",
        "REJECTED",
        "RETEST_REQUESTED",
        "DATA_CORRECTION_REQUIRED"
      ]
    },
    "correlation": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifactId",
          "path",
          "mimeType",
          "size",
          "sha256",
          "createdAt"
        ],
        "properties": {
          "artifactId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "masked": {
            "type": "boolean"
          }
        }
      }
    },
    "integrityStatus": {
      "enum": [
        "complete",
        "partial",
        "corrupted"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
